xsplit_basic<-split(x,~crop+Region+genotype+Irrigation)

# function to apply smoother
fsmooth_FHY<-function(xin,bandwidth=.25){
  #xin<-xsplit_basic[['maize.Colleambally.Late.Irrigated']]
  xx<-cbind(xin,fdate_order=rank(xin$flowering_date))
  
  mod0<-loess(FHY ~ fdate_order , data=xx,span = bandwidth)
  mod0_hat<-data.frame(FHY_hat=predict(mod0, xx),xx[,colnames(xx)%in%c("fdate_order","flowering_date")])
  # plot(xx$flowering_date,xx$FHY)
  # lines(mod0_hat$flowering_date,mod0_hat$FHY_hat)
  # lines(xx$flowering_date,xx$Meanyield ,col=2)
  
  cbind(xx,FHY_hat=mod0_hat$FHY_hat)
}

# find `optimal` period
xsplit<-lapply(xsplit_basic,FUN=fsmooth_FHY)
xsplit_max<-lapply(xsplit,function(i){i[i$FHY_hat>=(.95*max(i$FHY_hat)),]}) #quick and dirty window based on Meanyield
xsplit_max_opt<-lapply(xsplit_max,function(i){data.frame(i[1,1:4],ofp_min=min(i$flowering_date),ofp_max=max(i$flowering_date))})

ofp_dum<-do.call(rbind,xsplit_max_opt)
